# Copy to .env.local (gitignored) and fill in. Never commit real values.
XUNA_TEXT_PROVIDER=openai_compatible
XUNA_TEXT_BASE_URL=http://<internal-gateway-host>:<port>/v1
XUNA_TEXT_MODEL=<model-name>
XUNA_TEXT_API_KEY=<virtual-key>
# Bifrost gateways read the virtual key from x-bf-vk; others use Authorization: Bearer.
XUNA_TEXT_API_KEY_HEADER=x-bf-vk
XUNA_TEXT_TIMEOUT_S=30
# Thinking models (e.g. Gemini 3.x flash): "none" or "low" keeps short replies complete.
XUNA_TEXT_REASONING_EFFORT=
# Phone voice V1 test LLM (owner 2026-10-22): Groq https://api.groq.com/openai/v1,
# model openai/gpt-oss-120b, reasoning effort low, header authorization.
XUNA_FIREBASE_PROJECT_ID=xuna-pet
# Phone voice V1 (empty provider = off). ASR: any OpenAI-style /audio/transcriptions.
XUNA_ASR_PROVIDER=openai_transcription
XUNA_ASR_BASE_URL=https://api.groq.com/openai/v1
XUNA_ASR_MODEL=whisper-large-v3-turbo
XUNA_ASR_API_KEY=<key>
XUNA_ASR_TIMEOUT_S=10
XUNA_ASR_AUTO_DETECT=true
# TTS: edge (free online voices) or piper (pip install .[piper], GPL; set the .onnx path).
XUNA_TTS_PROVIDER=edge
XUNA_TTS_VOICE=vi-VN-HoaiMyNeural
XUNA_TTS_PIPER_MODEL=
XUNA_TTS_TIMEOUT_S=10
