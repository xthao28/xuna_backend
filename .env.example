# Copy to .env.local (gitignored) and fill in. Never commit real values.
XUNA_TEXT_PROVIDER=openai_compatible
XUNA_TEXT_BASE_URL=http://<internal-gateway-host>:<port>/v1
XUNA_TEXT_MODEL=<model-name>
XUNA_TEXT_API_KEY=<virtual-key>
# Bifrost gateways read the virtual key from x-bf-vk; others use Authorization: Bearer.
XUNA_TEXT_API_KEY_HEADER=x-bf-vk
XUNA_TEXT_TIMEOUT_S=30
XUNA_FIREBASE_PROJECT_ID=xuna-pet
